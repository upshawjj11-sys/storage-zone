{
  "name": "PageConfig",
  "type": "object",
  "properties": {
    "page_key": {
      "type": "string",
      "description": "Unique identifier for the page (e.g. 'pay_my_bill', 'locations')"
    },
    "hero_bg_color": {
      "type": "string"
    },
    "hero_bg_image": {
      "type": "string"
    },
    "hero_bg_image_overlay": {
      "type": "string"
    },
    "hero_title": {
      "type": "string"
    },
    "hero_subtitle": {
      "type": "string"
    },
    "hero_title_color": {
      "type": "string"
    },
    "hero_subtitle_color": {
      "type": "string"
    },
    "hero_padding_y": {
      "type": "string"
    },
    "hero_show_icon": {
      "type": "boolean",
      "default": true
    },
    "hero_icon_bg_color": {
      "type": "string"
    },
    "page_bg_color": {
      "type": "string"
    },
    "card_bg_color": {
      "type": "string"
    },
    "card_border_color": {
      "type": "string"
    },
    "card_border_radius": {
      "type": "string"
    },
    "card_shadow": {
      "type": "string"
    },
    "card_hover_border_color": {
      "type": "string"
    },
    "card_title_color": {
      "type": "string"
    },
    "card_subtitle_color": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "button_bg_color": {
      "type": "string"
    },
    "button_text_color": {
      "type": "string"
    },
    "button_border_radius": {
      "type": "string"
    },
    "search_bar_bg": {
      "type": "string"
    },
    "search_bar_text_color": {
      "type": "string"
    },
    "filter_active_bg": {
      "type": "string"
    },
    "filter_active_text": {
      "type": "string"
    },
    "filter_inactive_bg": {
      "type": "string"
    },
    "filter_inactive_text": {
      "type": "string"
    },
    "card_layout": {
      "type": "string",
      "enum": [
        "grid-3",
        "grid-2",
        "list"
      ],
      "default": "grid-3"
    },
    "show_facility_image": {
      "type": "boolean",
      "default": true
    },
    "show_facility_phone": {
      "type": "boolean",
      "default": true
    },
    "show_facility_address": {
      "type": "boolean",
      "default": true
    },
    "show_facility_features": {
      "type": "boolean",
      "default": true
    },
    "show_map_toggle": {
      "type": "boolean",
      "default": true
    },
    "show_filter_toggle": {
      "type": "boolean",
      "default": true
    },
    "show_near_me_button": {
      "type": "boolean",
      "default": true
    },
    "map_tile_style": {
      "type": "string"
    },
    "map_draggable": {
      "type": "boolean",
      "default": false
    },
    "map_marker_color": {
      "type": "string"
    },
    "map_user_dot_color": {
      "type": "string"
    },
    "search_radius_miles": {
      "type": "number",
      "default": 50
    },
    "allow_customer_radius_filter": {
      "type": "boolean",
      "default": false
    },
    "portal_header_bg": {
      "type": "string"
    },
    "portal_header_text_color": {
      "type": "string"
    },
    "portal_back_btn_color": {
      "type": "string"
    },
    "pmb_show_search_bar": {
      "type": "boolean",
      "default": true,
      "description": "Show/hide the facility search bar on Pay My Bill"
    },
    "pmb_search_bar_placeholder": {
      "type": "string",
      "description": "Placeholder text for the Pay My Bill search bar"
    },
    "pmb_search_bar_bg": {
      "type": "string",
      "description": "Background color of the Pay My Bill search bar"
    },
    "pmb_search_bar_text_color": {
      "type": "string",
      "description": "Text color of the Pay My Bill search bar"
    }
  },
  "required": [
    "page_key"
  ]
}